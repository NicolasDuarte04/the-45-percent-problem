#!/usr/bin/env bash
# Pre-push hook: abort if any commit being pushed introduces a git merge
# conflict marker. Catches the class of bug where a stash-pop conflict
# (or any unresolved merge) leaves <<<<<<< / ======= / >>>>>>> in tracked
# files and the push goes through because the markers are unstaged or
# slipped in unnoticed.
#
# Installed by scripts/install-hooks.sh — re-run that script after any
# change to this file. To bypass intentionally (NOT recommended), use:
#   git push --no-verify

set -euo pipefail

# Pattern matches the exact 7-character marker lines git writes. Opening
# and closing markers always have a space + label after them; the middle
# divider is exactly seven equals on its own line.
PATTERN='^<{7} |^={7}$|^>{7} '

NULL_SHA='0000000000000000000000000000000000000000'

found=0
# git pushes one ref per stdin line:
#   <local_ref> <local_oid> <remote_ref> <remote_oid>
while read -r _local_ref local_oid _remote_ref remote_oid; do
  # Skip deletions
  [ "$local_oid" = "$NULL_SHA" ] && continue

  if [ "$remote_oid" = "$NULL_SHA" ]; then
    # New branch on the remote: check commits not yet on any remote
    range=$(git rev-list "$local_oid" --not --remotes 2>/dev/null || true)
  else
    range=$(git rev-list "${remote_oid}..${local_oid}")
  fi

  for sha in $range; do
    files=$(git diff-tree --no-commit-id --name-only -r -m "$sha" 2>/dev/null | sort -u)
    for f in $files; do
      # File may have been deleted in this commit
      git cat-file -e "${sha}:${f}" 2>/dev/null || continue
      if git show "${sha}:${f}" 2>/dev/null | grep -qE "$PATTERN"; then
        echo "❌ pre-push: conflict marker in $f (commit ${sha:0:8})" >&2
        git show "${sha}:${f}" | grep -nE "$PATTERN" | head -5 | sed 's/^/     /' >&2
        found=1
      fi
    done
  done
done

if [ "$found" -ne 0 ]; then
  echo "" >&2
  echo "Push aborted. Resolve the conflict markers and amend the commit(s)." >&2
  echo "To bypass intentionally (NOT recommended): git push --no-verify" >&2
  exit 1
fi

exit 0
