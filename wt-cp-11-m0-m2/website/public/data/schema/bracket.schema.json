{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bracket",
  "title": "BracketSnapshot",
  "description": "Phase 9 §4 — Tournament bracket with per-round progression probabilities.",
  "type": "object",
  "required": ["snapshot_id", "rounds"],
  "additionalProperties": false,
  "properties": {
    "snapshot_id": { "type": "string" },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["round", "slots"],
        "additionalProperties": false,
        "properties": {
          "round": {
            "type": "string",
            "enum": ["GRP", "R32", "R16", "QF", "SF", "3P", "FIN"]
          },
          "slots": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    }
  }
}
