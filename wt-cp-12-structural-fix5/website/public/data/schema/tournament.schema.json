{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tournament",
  "title": "TournamentSnapshot",
  "description": "Phase 9 §4.3 — Top-level championship probabilities for the Landing page.",
  "type": "object",
  "required": ["snapshot_id", "generated_at_utc", "mc_runs", "teams"],
  "additionalProperties": false,
  "properties": {
    "snapshot_id": { "type": "string" },
    "generated_at_utc": { "type": "string" },
    "mc_runs": { "type": "integer", "minimum": 100 },
    "teams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "fifa_code", "display_name", "confederation", "seed",
          "p_champion", "p_final", "p_semifinal", "p_quarterfinal",
          "p_r16", "p_group_qualification", "ci_95_champion",
          "elo_current", "rank_change_7d"
        ],
        "additionalProperties": false,
        "properties": {
          "fifa_code":    { "type": "string", "minLength": 2, "maxLength": 6 },
          "display_name": { "type": "string" },
          "confederation": {
            "type": "string",
            "enum": ["CONMEBOL", "UEFA", "CONCACAF", "AFC", "CAF", "OFC"]
          },
          "seed": { "type": "integer", "minimum": 1 },
          "p_champion":           { "type": "number", "minimum": 0, "maximum": 1 },
          "p_final":              { "type": "number", "minimum": 0, "maximum": 1 },
          "p_semifinal":          { "type": "number", "minimum": 0, "maximum": 1 },
          "p_quarterfinal":       { "type": "number", "minimum": 0, "maximum": 1 },
          "p_r16":                { "type": "number", "minimum": 0, "maximum": 1 },
          "p_group_qualification":{ "type": "number", "minimum": 0, "maximum": 1 },
          "ci_95_champion": {
            "type": "array",
            "items": { "type": "number", "minimum": 0, "maximum": 1 },
            "minItems": 2,
            "maxItems": 2
          },
          "elo_current":    { "type": "number" },
          "rank_change_7d": { "type": "number" },
          "group": { "type": "string" }
        }
      }
    }
  }
}
