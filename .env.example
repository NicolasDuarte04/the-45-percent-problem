# =============================================================================
# The 45% Problem — Environment Variables
# Copy this file to .env and populate with your actual keys.
# NEVER commit .env to git — it is in .gitignore.
# =============================================================================

# ─── Market data APIs ─────────────────────────────────────────────────────────
PINNACLE_API_KEY=your_pinnacle_key_here
BETFAIR_API_KEY=your_betfair_key_here
POLYMARKET_API_KEY=

# ─── Football data ────────────────────────────────────────────────────────────
# football-data.org (free tier covers international results)
FOOTBALL_DATA_ORG_KEY=your_key_here

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console     # console | json
LOG_DIR=logs
