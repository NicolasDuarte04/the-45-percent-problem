# Required for production — set this to the live domain before deploying.
NEXT_PUBLIC_SITE_URL=https://45analytics.com

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Runtime serverless connections. Pooler URL preferred (port 6543, with
# ?pgbouncer=true&connection_limit=1). Phase 1 falls back to the direct URL
# if no pooler is configured yet.
DATABASE_URL=

# Migrations only. Direct URL (port 5432). Optional in Phase 1; if absent,
# drizzle-kit will fall back to DATABASE_URL.
DIRECT_URL=

# ── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_ADDRESS=brief@45analytics.com
RESEND_REPLY_TO=hello@45analytics.com
# Resend webhook signing secret (whsec_...). Add a webhook in the Resend
# dashboard pointing at <site>/api/webhooks/resend, subscribe to the
# delivered / bounced / complained (and optionally opened / clicked) events,
# and paste the signing secret it shows here.
RESEND_WEBHOOK_SECRET=

# ── HMAC + admin secrets ─────────────────────────────────────────────────────
# 32+ random bytes. Generate via: openssl rand -hex 32
UNSUBSCRIBE_HMAC_SECRET=
# Admin token for the manual brief replay route (Phase 4).
BRIEF_DISPATCH_TOKEN=
# Set automatically by Vercel Cron at runtime; no value needed locally.
CRON_SECRET=

# ── On-demand snapshot regeneration (cp-13 / Fix 6) ──────────────────────────
# Fine-grained GitHub PAT with `actions: write` on this repo. The match-outcome
# endpoints use it to fire a repository_dispatch (event: regen-snapshot) that
# runs .github/workflows/on_demand_regen.yml after a settled outcome is upserted,
# so the public bracket refreshes within minutes instead of at the next nightly.
# Absent → endpoints report regenDispatch.reason "not_configured" and degrade to
# the nightly-cron safety net (no error). Set this in production to close
# acceptance criterion #8.
GITHUB_REGEN_PAT=
# Owner/repo for the dispatch. Optional: defaults to Vercel's VERCEL_GIT_REPO_*
# system vars, then to NicolasDuarte04/the-45-percent-problem. Override only for
# a fork or a renamed repo.
GITHUB_REGEN_OWNER=
GITHUB_REGEN_REPO=

# ── Vercel Blob (daily brief JSON storage) ───────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Cloudflare Turnstile (deferred in v1) ────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Upstash Redis (deferred — Phase 1 uses an in-memory stand-in) ────────────
# Populate when swapping the rate-limiter in src/lib/ratelimit.ts
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Sentry (deferred — wire up alongside Phase 4 cron) ───────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
